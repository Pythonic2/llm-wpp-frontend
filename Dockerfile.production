FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Production always talks to the same-origin Nginx proxy. Keeping this value
# fixed prevents stale Portainer build arguments from embedding an external URL.
ENV VITE_API_BASE_URL=/api/v1

RUN npm run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
