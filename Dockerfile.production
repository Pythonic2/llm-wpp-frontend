# The frontend build only produces architecture-independent static files. Run
# Node on the builder's native architecture so ARM64 cross-builds do not have
# to execute npm (and its native binaries) through QEMU.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Production always talks to the same-origin Nginx proxy. Keeping this value
# fixed prevents stale Portainer build arguments from embedding an external URL.
ENV VITE_API_BASE_URL=/api/v1

RUN npm run build

FROM nginx:alpine
ARG APP_COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=$APP_COMMIT_SHA
ENV APP_COMMIT_SHA=$APP_COMMIT_SHA
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
